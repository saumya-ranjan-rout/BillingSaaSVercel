{
  "version": 2,
  "projects": {
    "backend": {
      "src": "packages/backend/dist/index.js",
      "use": "@vercel/node"
    },
    "frontend": {
      "src": "packages/frontend",
      "use": "@vercel/static"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "packages/backend/dist/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "packages/frontend/$1"
    }
  ]
}
